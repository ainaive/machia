[Unit]
Description=Machia bot competition platform
After=network.target

[Service]
Type=simple
# Unprivileged system user; bots run as this user too, inside the sandbox.
User=machia
Group=machia
WorkingDirectory=/opt/machia
EnvironmentFile=/etc/machia.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Bun's transpiler cache would need a writable home; skip it.
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# Run bots in bubblewrap with per-bot limits (docs/deploy.md, "Bot sandbox").
Environment=MACHIA_SANDBOX=bwrap
ExecStart=/usr/local/bin/bun run --filter @machia/server start
Restart=on-failure
RestartSec=3
KillMode=control-group

# Hardening: read-only system and app checkout; only data/ is writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/machia/data
# The API manages one cgroup per bot below its own (systemd 254+).
Delegate=yes
DelegateSubgroup=server
# Backstop for the API plus every running bot (each bot: 256MB, 32 tasks).
MemoryMax=3G
TasksMax=512

[Install]
WantedBy=multi-user.target
