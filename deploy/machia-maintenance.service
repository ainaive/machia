[Unit]
Description=Machia daily maintenance: backups and replay cleanup
After=network.target

[Service]
Type=oneshot
User=machia
Group=machia
WorkingDirectory=/opt/machia
EnvironmentFile=/etc/machia.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ExecStart=/usr/local/bin/bun run --filter @machia/server maintenance

# Same hardening as machia.service; backups go to data/backups by default.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/machia/data
